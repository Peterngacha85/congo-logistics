MONGODB_URI=mongodb://127.0.0.1:27017/congo_logistics_db

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRE_TIME=86400
JWT_REFRESH_EXPIRE_TIME=604800
JWT_REFRESH_EXPIRE_TIME_REMEMBER=2592000

NODE_ENV=development
API_PORT=5000

# Super Admin account is bootstrapped from these on server startup (no public
# registration route exists for SUPER_ADMIN) - change ADMIN_PASSWORD here to
# rotate it; the server syncs the DB record to match on next restart.
ADMIN_EMAIL=admin@congologistics.com
ADMIN_PASSWORD=change-this-strong-password

ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=debug

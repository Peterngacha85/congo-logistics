MONGODB_URI=mongodb://127.0.0.1:27017/congo_logistics_db

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRE_TIME=86400
JWT_REFRESH_EXPIRE_TIME=604800
JWT_REFRESH_EXPIRE_TIME_REMEMBER=2592000

NODE_ENV=development
API_PORT=5000

# Up to 3 Super Admin accounts are bootstrapped from these on server startup
# (no public registration route exists for SUPER_ADMIN). Fill in only the
# slots you need - 2 and 3 are optional. Change a password here to rotate it;
# the server syncs the matching DB record on next restart.
ADMIN_1_EMAIL=admin@congologistics.com
ADMIN_1_PASSWORD=change-this-strong-password
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
ADMIN_3_EMAIL=
ADMIN_3_PASSWORD=

ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=debug
